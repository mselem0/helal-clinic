    "faqs": [
      {
        "question": "إزاي أحجز موعد؟",
        "answer": "اختاري الفرع والخدمة واليوم المفضل، ثم أرسلي طلبكِ. يؤكد فريق العيادة تفاصيل الموعد بالتواصل معكِ."
      },
      {
        "question": "أجهّز إيه لأول زيارة؟",
        "answer": "خدي معكِ التقارير والتحاليل السابقة إن وُجدت، وقائمة الأدوية الحالية. اسألي فريق العيادة لو فيه تجهيزات خاصة لزيارتكِ."
      },
      {
        "question": "هل اليوم اللي اختارته حجز مؤكّد؟",
        "answer": "اختيار اليوم هو طلب مبدئي؛ لا يُعتبر الموعد مؤكدًا قبل تواصل فريق العيادة معكِ."
      }
    ]
  },
